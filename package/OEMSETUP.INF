sw03h    = W:s3wide.drv, "S3Wide 1024x768  65K colors"       , "100,96,96", , W:vgalogo.lgo, x:*vddvga, W:vga.3gr,,  W:vgalogo.rle, sw03h
sw03t    = W:s3wide.drv, "S3Wide 1024x768  16M colors"       , "100,96,96", , W:vgalogo.lgo, x:*vddvga, W:vga.3gr,,  W:vgalogo.rle, sw03t
sw04p    = W:s3wide.drv, "S3Wide 1280x720  256 colors"       , "100,96,96", , W:vgalogo.lgo, x:*vddvga, W:vga.3gr,,  W:vgalogo.rle, sw04p
sw04h    = W:s3wide.drv, "S3Wide 1280x720  65K colors"       , "100,96,96", , W:vgalogo.lgo, x:*vddvga, W:vga.3gr,,  W:vgalogo.rle, sw04h
sw04t    = W:s3wide.drv, "S3Wide 1280x720  16M colors"       , "100,96,96", , W:vgalogo.lgo, x:*vddvga, W:vga.3gr,,  W:vgalogo.rle, sw04t
