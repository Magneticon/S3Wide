; ---------------------------------------------------------------
; S3Wide display driver for Windows 3.1 / Windows for Workgroups 3.11
; Install with Windows Setup: Options, Change System Settings,
; Display, "Other display (Requires disk from OEM)...", then the
; folder that holds this file and S3WIDE.DRV.
;
; Every entry uses the same driver; the mode goes to [s3wide.drv] in
; SYSTEM.INI (Width, Height, Depth). If the video BIOS lacks the mode,
; the driver starts in the largest one it can draw that is no larger.
; 1280x720 256 colors on an S3 Trio64 uses the S3 registers directly.
;
; Run S3PREP first: it makes S3WIDE.DRV from S3WIDE.BIN and your own
; VGA.DRV, and copies the grabber, logo and fonts Setup installs for a
; VGA-style display (VGA.3GR, VGALOGO.*, VGA*.FON, *WOA.FON) into the
; package folder: when Setup asks for a Windows disk, give it that folder.
; ---------------------------------------------------------------

[data]
    Version="3.10"

[oemdisks]
    W =. ,"S3Wide display driver",s3widedisk

[display]
;profile  = driver,       description,                        resolution,  286gr, logo code,     VDD,       386grabber, ega.sys, logo data,    work section
sw01p    = W:s3wide.drv, "S3Wide  640x480  256 colors"       , "100,96,96", , W:vgalogo.lgo, x:*vddvga, W:vga.3gr,,  W:vgalogo.rle, sw01p
sw01h    = W:s3wide.drv, "S3Wide  640x480  65K colors"       , "100,96,96", , W:vgalogo.lgo, x:*vddvga, W:vga.3gr,,  W:vgalogo.rle, sw01h
sw01t    = W:s3wide.drv, "S3Wide  640x480  16M colors"       , "100,96,96", , W:vgalogo.lgo, x:*vddvga, W:vga.3gr,,  W:vgalogo.rle, sw01t
sw02p    = W:s3wide.drv, "S3Wide  800x600  256 colors"       , "100,96,96", , W:vgalogo.lgo, x:*vddvga, W:vga.3gr,,  W:vgalogo.rle, sw02p
sw02h    = W:s3wide.drv, "S3Wide  800x600  65K colors"       , "100,96,96", , W:vgalogo.lgo, x:*vddvga, W:vga.3gr,,  W:vgalogo.rle, sw02h
sw02t    = W:s3wide.drv, "S3Wide  800x600  16M colors"       , "100,96,96", , W:vgalogo.lgo, x:*vddvga, W:vga.3gr,,  W:vgalogo.rle, sw02t
