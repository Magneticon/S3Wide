system windows dll initinstance memory
option oneautodata
option map=build/driver_smoke.map
option quiet
file build/s3_gdiinfo.obj
file build/s3_color.obj
file build/s3_surface.obj
file build/s3_hw.obj
file build/s3_vga_state.obj
file build/s3_win16_bridge.obj
file build/s3_win16_native.obj
file build/s3_device.obj
file build/s3_exports.obj
file build/s3_gdi_stubs.obj
file build/s3_trace.obj
file build/libentry.obj
name build/s3wide_driver.dll
# GDI binds the display driver as module DISPLAY; the description follows
# the stock "DISPLAY : aspect, x dpi, y dpi : name" form.
option modname=DISPLAY
option description 'DISPLAY : 100, 96, 96 : S3 Trio64 1280x720 256 colors (S3Wide)'
option resource=build/driver_smoke.res
# DDA ordinals match the WfW 3.11 stock VGA.DRV export table.
export BitBlt.1=BITBLT
export ColorInfo.2=COLORINFO
export Disable.4=DISABLE
export Enable.5=ENABLE
export Output.8=OUTPUT
export Pixel.9=PIXEL
export RealizeObject.10=REALIZEOBJECT
export SetDIBitsToDevice.21=SETDIBITSTODEVICE
export GetDriverResourceID.450=GETDRIVERRESOURCEID
