/* The DDA requires VERSIONINFO. This display driver provides no device fonts;
   its RealizeObject returns zero for OBJ_FONT so GDI uses system fonts. */
1 VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x00010001L
FILETYPE       0x00000003L
FILESUBTYPE    0x00000004L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "S3 widescreen display driver\0"
      VALUE "FileVersion", "1, 0, 0, 0\0"
      VALUE "InternalName", "S3WIDE\0"
      VALUE "OriginalFilename", "S3WIDE_DRIVER.DLL\0"
      VALUE "ProductName", "S3 widescreen display driver\0"
      VALUE "ProductVersion", "1, 0, 0, 0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
